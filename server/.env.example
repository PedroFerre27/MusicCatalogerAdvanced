# .env.example — copia in .env prima di avviare
# Il .env vero NON va committato (è in .gitignore)
#
# Preconfigurato per PRODUZIONE su NAS Synology. Per sviluppo locale
# cambia ENV=development, DEBUG=true, DATABASE_URL a path relativo,
# e CORS_ORIGINS=["http://localhost:3000"].

# ── Ambiente ──────────────────────────────────────────────────────
ENV=production
DEBUG=false

# ── JWT — OBBLIGATORIO in produzione ──────────────────────────────
# Genera una chiave sicura con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE-ME-WITH-A-REAL-SECRET-KEY-64-CHARS

# Durata token
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ──────────────────────────────────────────────────────
# In container il path è assoluto /srv/app/data/app.db (bind mount al NAS)
# Il client SQLite richiede 4 slash: sqlite:////path/assoluto.
DATABASE_URL=sqlite:////srv/app/data/app.db

# Quando passerai a PostgreSQL (opzionale, post-MVP):
# DATABASE_URL=postgresql://mcs:password@postgres:5432/mcs

# ── CORS ──────────────────────────────────────────────────────────
# Domini autorizzati a chiamare l'API. Il client GUI di produzione
# passa via reverse proxy DSM (api.choros27.synology.me).
CORS_ORIGINS=["https://choros27.synology.me","https://api.choros27.synology.me"]

# ── Admin iniziale ────────────────────────────────────────────────
# Creato al primo avvio se il DB è vuoto
ADMIN_EMAIL=admin@choros27.synology.me
ADMIN_PASSWORD=ChangeMeAt-FirstLogin-123

# ── Paths (solo override se diversi dal default) ──────────────────
# MUSIC_DIR=/music
# OUTPUT_DIR=/output

# ── SMTP — Email transazionali (v0.2.4, R3) ───────────────────────
# Configurazione per email di benvenuto utenti e notifica admin alla
# registrazione. Default qui sotto: Gmail su porta 587 (STARTTLS).
#
# Per Gmail: genera una App Password da
#   https://myaccount.google.com/apppasswords
# e mettila in SMTP_PASSWORD. NON usare la password normale (Google
# rifiuta i login basic da app esterne dal 2022).
#
# Se SMTP_HOST o SMTP_USER restano vuoti, il server logga un warning
# e SALTA l'invio email: la registrazione funziona comunque.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# SMTP_FROM opzionale: se vuoto usa SMTP_USER come mittente
SMTP_FROM=

# Email che riceve la notifica "Nuovo utente registrato". Se vuoto,
# la notifica admin viene saltata (l'email di benvenuto all'utente
# parte comunque).
ADMIN_NOTIFY_EMAIL=
